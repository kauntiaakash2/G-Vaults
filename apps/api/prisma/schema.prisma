generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum CaseRole {
  OWNER
  LEAD
  MEMBER
  VIEWER
}

enum DocumentPermission {
  VIEW
  DOWNLOAD
  EDIT
  SHARE
  APPROVE
}

enum PermissionStatus {
  ACTIVE
  REVOKED
}

enum AuditResult {
  SUCCESS
  DENIED
  FAILURE
}

enum ProcessingJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  users       User[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model Department {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  users       User[]
  cases       Case[]
  ownedDocuments Document[]           @relation("DocumentOwnerDepartment")
  documentPermissions DocumentPermissionGrant[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  passwordHash        String               @map("password_hash")
  roleId              String               @map("role_id")
  departmentId        String?              @map("department_id")
  status              UserStatus           @default(ACTIVE)
  role                Role                 @relation(fields: [roleId], references: [id])
  department          Department?          @relation(fields: [departmentId], references: [id])
  createdCases        Case[]               @relation("CaseCreator")
  caseMemberships     CaseMember[]
  documentPermissions DocumentPermissionGrant[] @relation("PermissionUser")
  grantedPermissions  DocumentPermissionGrant[] @relation("PermissionGrantor")
  auditEvents         AuditEvent[]
  uploadedVersions    DocumentVersion[]    @relation("VersionUploader")
  createdDocuments    Document[]           @relation("DocumentCreator")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([roleId])
  @@index([departmentId])
  @@map("users")
}

model Case {
  id           String       @id @default(uuid())
  caseNumber   String       @unique @map("case_number")
  title        String
  description  String?
  departmentId String       @map("department_id")
  status       CaseStatus   @default(OPEN)
  createdById  String       @map("created_by")
  department   Department   @relation(fields: [departmentId], references: [id])
  createdBy    User         @relation("CaseCreator", fields: [createdById], references: [id])
  members      CaseMember[]
  documents    Document[]
  auditEvents  AuditEvent[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([createdById])
  @@map("cases")
}

model CaseMember {
  caseId    String   @map("case_id")
  userId    String   @map("user_id")
  caseRole  CaseRole @default(MEMBER) @map("case_role")
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([caseId, userId])
  @@index([userId])
  @@map("case_members")
}

model Document {
  id                String                    @id @default(uuid())
  caseId            String                    @map("case_id")
  title             String
  documentType      String                    @map("document_type")
  ownerDepartmentId String                    @map("owner_department_id")
  currentVersionId  String?                   @unique @map("current_version_id")
  createdById       String                    @map("created_by")
  case              Case                      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ownerDepartment   Department                @relation("DocumentOwnerDepartment", fields: [ownerDepartmentId], references: [id])
  createdBy         User                      @relation("DocumentCreator", fields: [createdById], references: [id])
  currentVersion    DocumentVersion?          @relation("CurrentDocumentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  versions          DocumentVersion[]         @relation("DocumentVersions")
  permissions       DocumentPermissionGrant[]
  auditEvents       AuditEvent[]
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  @@index([caseId])
  @@index([ownerDepartmentId])
  @@index([createdById])
  @@map("documents")
}

model DocumentVersion {
  id                String          @id @default(uuid())
  documentId        String          @map("document_id")
  versionNumber     Int             @map("version_number")
  storageKey        String          @unique @map("storage_key")
  sha256Hash        String          @map("sha256_hash")
  fileSize          BigInt          @map("file_size")
  mimeType          String          @map("mime_type")
  originalFilename  String          @map("original_filename")
  createdById       String          @map("created_by")
  changeDescription String?         @map("change_description")
  document          Document        @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  currentFor        Document?       @relation("CurrentDocumentVersion")
  creator           User            @relation("VersionUploader", fields: [createdById], references: [id])
  auditEvents       AuditEvent[]
  processingJobs    ProcessingJob[]
  ocrResult         OcrResult?
  aiSummary         AiSummary?
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([documentId, versionNumber])
  @@index([createdById])
  @@map("document_versions")
}

model DocumentPermissionGrant {
  id           String             @id @default(uuid())
  documentId   String             @map("document_id")
  departmentId String?            @map("department_id")
  userId       String?            @map("user_id")
  permission   DocumentPermission
  status       PermissionStatus   @default(ACTIVE)
  grantedById  String             @map("granted_by")
  document     Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User?              @relation("PermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy    User               @relation("PermissionGrantor", fields: [grantedById], references: [id])
  createdAt    DateTime           @default(now()) @map("created_at")
  revokedAt    DateTime?          @map("revoked_at")

  @@index([documentId, status])
  @@index([departmentId])
  @@index([userId])
  @@map("document_permissions")
}

model AuditEvent {
  id           String           @id @default(uuid())
  userId       String?          @map("user_id")
  action       String
  entityType   String           @map("entity_type")
  entityId     String           @map("entity_id")
  documentId   String?          @map("document_id")
  versionId    String?          @map("version_id")
  caseId       String?          @map("case_id")
  result       AuditResult      @default(SUCCESS)
  metadata     Json?
  ipAddress    String?          @map("ip_address")
  previousHash String?          @map("previous_hash")
  eventHash    String           @unique @map("event_hash")
  actor        User?            @relation(fields: [userId], references: [id])
  case         Case?            @relation(fields: [caseId], references: [id])
  document     Document?        @relation(fields: [documentId], references: [id])
  version      DocumentVersion? @relation(fields: [versionId], references: [id])
  createdAt    DateTime         @default(now()) @map("timestamp")

  @@index([userId])
  @@index([caseId])
  @@index([documentId])
  @@index([versionId])
  @@index([entityType, entityId])
  @@map("audit_events")
}

model ProcessingJob {
  id                String              @id @default(uuid())
  documentVersionId String              @map("document_version_id")
  type              String              @default("OCR")
  status            ProcessingJobStatus @default(PENDING)
  attempts          Int                 @default(0)
  error             String?
  documentVersion   DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")

  @@index([status, createdAt])
  @@map("processing_jobs")
}

model OcrResult {
  id                String          @id @default(uuid())
  documentVersionId String          @unique @map("document_version_id")
  status            String          @default("COMPLETED")
  text              String          @db.Text
  pageCount         Int             @default(1) @map("page_count")
  engine            String
  language          String          @default("und")
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  @@map("ocr_results")
}

model AiSummary {
  id                String          @id @default(uuid())
  documentVersionId String          @unique @map("document_version_id")
  summary           String          @db.Text
  model             String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("ai_summaries")
}
