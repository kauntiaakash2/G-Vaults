NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

POSTGRES_DB=sih
POSTGRES_USER=sih
POSTGRES_PASSWORD=sih_local_password
DATABASE_URL=postgresql://sih:sih_local_password@localhost:5432/sih?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
# Local-only example. Replace with 64 random hex characters in every deployed environment.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
MAX_UPLOAD_BYTES=20971520
# Set to http://localhost:8000 when the optional OCR worker is running.
OCR_SERVICE_URL=
# API-to-worker credential. Generate a distinct random value (32+ characters).
OCR_INTERNAL_TOKEN=local-only-ocr-token-change-me-26190

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=sih_minio
MINIO_SECRET_KEY=sih_minio_local_password
MINIO_BUCKET=sih-documents

SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=ChangeMe123!
